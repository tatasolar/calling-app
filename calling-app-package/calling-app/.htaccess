Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), payment=()"
</IfModule>

<FilesMatch "^\.env">
  Require all denied
</FilesMatch>

<FilesMatch "\.(sql|log|ini|bak|old)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^recordings/ - [F,NC,L]
  RewriteRule ^uploads/.*\.(?:php[0-9]?|phtml|phar|cgi|pl|py|asp|sh)$ - [F,NC,L]
</IfModule>
